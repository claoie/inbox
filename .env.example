EMAIL_DOMAIN=inbox.app
APP_HOSTNAME=inbox.app

# Opt in to the production posture: JSON logs, HSTS, secure cookies, trust
# proxy, and generic 500 bodies instead of error messages. Read at runtime by
# src/server/lib/env.ts, so it belongs in the deployment's environment — the
# image does not set it. Unset means development posture.
# NODE_ENV=production

# Optional: Discord webhook URL for server error alarms (unhandled exceptions, 5xx errors, client JS errors)
# DISCORD_ALARM_WEBHOOK=https://discord.com/api/webhooks/...

# Signs the session cookie. Required when NODE_ENV=production — the server refuses
# to boot when it is unset or set to a value this repository publishes, because
# either one lets anyone forge a validly-signed cookie. Outside production an unset
# value warns and falls back to a fixed development key.
# Generate with: openssl rand -base64 32
SECRET=

# Password for the built-in `admin` account. Applied when the account is first
# created; afterwards the stored password wins, so a password changed through
# the app survives a restart. Unset seeds the account with `inbox`.
ADMIN_PASSWORD=inbox

# Optional: set to 1 for one boot to replace admin's stored password with
# ADMIN_PASSWORD — the recovery path for a lost admin password. It re-applies on
# every boot while it stays set, so remove it once the password is back.
# Read by src/server/lib/postgres/initialize.ts.
# ADMIN_PASSWORD_RESET=1

# Optional: password for a read-only administrative account seeded at boot.
# Setting it enables a session-scoped read-only role: authenticating with
# `admin-ro`/$ADMIN_RO_PASSWORD produces a session whose effective identity
# is `admin` for every read path, and whose `isReadOnly` flag refuses every
# mutating HTTP / IMAP / SMTP surface. Leaving it unset revokes the account on
# the next boot and deletes the sessions it already issued, so removing the
# variable and redeploying withdraws the role in full. Changing it to a new
# value does the same: the next boot refuses the old password and deletes the
# sessions it issued, so rotating a leaked credential is a complete
# remediation. Redeploying with an unchanged value logs nobody out.
# Read by src/server/lib/postgres/initialize.ts.
# ADMIN_RO_PASSWORD=

# Mailgun API key for email sending
MAILGUN_KEY=

# Optional: root of Mailgun's HTTP API. Defaults to https://api.mailgun.net; set
# https://api.eu.mailgun.net for an EU-region domain, or a local stub in tests.
# MAILGUN_URL=

# Mailgun webhook signing key (Mailgun dashboard → Settings → Webhooks).
# Required for POST /api/mailgun-events to verify Mailgun's HMAC-signed
# delivery-event callbacks; unset = webhook rejects all requests.
MAILGUN_WEBHOOK_SIGNING_KEY=

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=mail

PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

SSL_CERTIFICATE=
SSL_CERTIFICATE_KEY=

# Optional: HTTP listen port. Default: 3004. See src/server/lib/http/index.ts.
# PORT=3004

# Optional: override default mail-server ports (useful in sandbox/dev where
# the privileged ports are already taken). When unset, the defaults below apply.
# SMTP_PORT=25
# SMTPS_PORT=465
# SMTP_SUBMISSION_PORT=587
# IMAP_PORT=143
# IMAP_TLS_PORT=993

# Optional: set to true when a TCP proxy in front of the mail ports (nginx's
# stream module with `proxy_protocol on`) sends a PROXY protocol v1 header on
# every SMTP and IMAP connection. The header is then required, and accepted
# only from loopback or private addresses. The client address it names is
# what the DNSBL spam check, the login rate limits and the logs see. Leave it
# unset when clients connect to these ports directly.
# PROXY_PROTOCOL=true

# Optional: log verbosity. One of debug | info | warn | error.
# Default: info (or error when NODE_ENV=test). See src/server/lib/logger.ts.
# LOG_LEVEL=info

# Optional: how many IMAP BODY fetches may run at once. Lower to cap the
# memory a body-fetch burst can hold; raise to trade memory for sync speed.
# Values below 1 or unparseable are rejected with a warning and the default
# applies. Default: 3. See src/server/lib/imap/body-budget.ts.
# IMAP_BODY_FETCH_CONCURRENCY=3

# Optional: how many memory-heavy IMAP commands (SELECT/FETCH/SEARCH/STATUS/
# etc.) may run at once across ALL connections. Bounds the aggregate worst
# case so a client opening several connections and bursting these can't pin
# process memory near the container limit. A command that ends up waiting
# on IMAP_BODY_FETCH_CONCURRENCY's own limit (a streaming BODY[] fetch)
# gives this slot up for that wait, so the two settings are independent —
# see src/server/lib/imap/command-budget-hold.ts. Values below 1 or
# unparseable are rejected with a warning and the default applies.
# Default: 8. See src/server/lib/imap/command-budget.ts.
# IMAP_COMMAND_CONCURRENCY=8

# Optional: how many SMTP DATA transactions may materialize a message at once
# across ALL connections. The per-message ceiling is multiplied by the
# connection limit without this, so a burst of large messages can hold many
# decoded copies at once; measured here, 20 concurrent 20 MiB messages peaked
# at 1249 MB of RSS unbounded against 414 MB at the default. A transaction
# that cannot get a slot waits rather than allocating, and is answered 421
# only if no slot frees up within 20s. Values below 1 or unparseable are
# rejected with a warning and the default applies.
# Default: 2. See src/server/lib/smtp-data-budget.ts.
# SMTP_DATA_CONCURRENCY=2

# Optional: set to 1 to log every inbound IMAP command line and the outbound
# framing responses. Credentials are redacted and each line is capped, but the
# trace is still verbose — diagnostic use only. Default: off.
# See src/server/lib/imap/trace.ts.
# IMAP_TRACE=1
