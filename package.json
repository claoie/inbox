{
  "name": "mail",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun run build && bun run start-server",
    "start-server": "bun ./build/server/bundle.js",
    "build": "bun run build-server && bun run build-client",
    "build-client": "bun vite build",
    "build-server": "bun ./src/server/pack.ts",
    "dev": "bun run dev-client & bun run dev-server",
    "dev-client": "bun vite",
    "dev-server": "bun --watch ./src/server/start.ts",
    "migrate": "bun scripts/migrate-es-to-pg.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov && bun scripts/check-coverage.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "bun run --bun tsc --noEmit",
    "preview": "bun vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "web-push": "^3.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.10.6",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^12.8.3",
    "@types/bun": "^1.1.0",
    "@types/marked": "4",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "@types/web-push": "^3.3.2",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^10.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.3.0",
    "marked": "^4.0.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6",
    "sass": "^1.97.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
